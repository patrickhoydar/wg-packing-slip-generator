// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Customer {
  id             String     @id @default(uuid())
  customerCode   String     @unique @map("customer_code")
  displayName    String     @map("display_name")
  defaultShipVia Int?       @map("default_ship_via")
  metadata       Json?
  jobs           Job[]
  templates      Template[]
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  @@map("customers")
}

model Job {
  id               String     @id @default(uuid())
  jobNumber        String     @map("job_number")
  customerId       String     @map("customer_id")
  customer         Customer   @relation(fields: [customerId], references: [id])
  uploadedFileName String     @map("uploaded_file_name")
  status           JobStatus
  totalShipments   Int        @default(0) @map("total_shipments")
  shipments        Shipment[]
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  @@unique([customerId, jobNumber])
  @@map("jobs")
}

model Shipment {
  id               String         @id @default(uuid())
  jobId            String         @map("job_id")
  job              Job            @relation(fields: [jobId], references: [id])
  erpShipmentId    String?        @map("erp_shipment_id")
  erpSystem        String?        @map("erp_system")
  kitData          Json           @map("kit_data")
  recipientName    String         @map("recipient_name")
  recipientCompany String?        @map("recipient_company")
  shippingAddress  Json           @map("shipping_address")
  status           ShipmentStatus
  erpResponse      Json?          @map("erp_response")
  pdfPath          String?        @map("pdf_path")
  items            ShipmentItem[]
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  @@index([erpShipmentId])
  @@index([jobId, status])
  @@map("shipments")
}

model ShipmentItem {
  id               String   @id @default(uuid())
  shipmentId       String   @map("shipment_id")
  shipment         Shipment @relation(fields: [shipmentId], references: [id])
  sku              String
  description      String
  quantity         Int
  customProperties Json?    @map("custom_properties")

  @@map("shipment_items")
}

enum JobStatus {
  uploaded
  processing
  erp_creating
  completed
  failed

  @@map("job_status")
}

enum ShipmentStatus {
  pending
  erp_created
  pdf_generated
  failed

  @@map("shipment_status")
}

model Template {
  id           String   @id @default(uuid())
  name         String
  customerId   String?  @map("customer_id")
  customer     Customer? @relation(fields: [customerId], references: [id])
  customerCode String?  @map("customer_code")
  elements     Json     // Array of template elements with positions
  pageSettings Json     @map("page_settings") // Page size, margins, etc.
  styles       Json?    // Global styles for the template
  isDefault    Boolean  @default(false) @map("is_default")
  isActive     Boolean  @default(true) @map("is_active")
  version      Int      @default(1)
  createdBy    String?  @map("created_by")
  metadata     Json?    // Additional metadata
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([customerId])
  @@index([customerCode])
  @@index([isDefault])
  @@map("templates")
}
