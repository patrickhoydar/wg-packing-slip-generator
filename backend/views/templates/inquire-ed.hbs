<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Packing Slip</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>{{{styles}}}</style>
</head>
<body>
  <div class="packing-slip-container">
    <div class="packing-slip-content">
      <!-- Header -->
      <div class="header">
        <div class="header-border flex items-end justify-between">
          <div class="company-info">
            2450 Meadowbrook Pkwy Duluth, GA 30096, Phone: 877-415-7323
          </div>
          <h1 class="packing-list-title">PACKING LIST</h1>
        </div>
      </div>

      <!-- Job Numbers -->
      <div class="job-info">
        <div class="flex items-center justify-between mb-4">
          <div class="text-left">
            <p class="job-number">Job No: {{jobInfo.jobNumber}}</p>
          </div>
        </div>
      </div>

      <!-- Ship To Information -->
      <div class="ship-to">
        <div>
          <h3 class="ship-to-title">Ship To:</h3>
          <div class="ship-to-details">
            {{#if shipTo.company}}
            <p class="company-name">{{shipTo.company}}</p>
            {{/if}}
            <p class="company-name">{{shipTo.name}}</p>
            <p>{{shipTo.address.street}}</p>
            <p>{{shipTo.address.city}}, {{shipTo.address.state}} {{shipTo.address.zipCode}}, {{shipTo.address.country}}</p>
            {{#if shipTo.email}}
            <p>{{shipTo.email}}</p>
            {{/if}}
          </div>
        </div>
      </div>

      <!-- Delivery Requirements -->
      {{#if deliveryInfo}}
      <div class="delivery-requirements">
        <div class="delivery-requirements-details">
          <div class="delivery-row">
            <div class="delivery-col">
              <p><strong>Shipping Method:</strong> {{shippingMethod}}</p>
            </div>
            <div class="delivery-col">
              {{#if deliveryInfo.appointmentRequired}}
              <p><strong>⚠️ APPOINTMENT REQUIRED</strong></p>
              {{/if}}
            </div>
          </div>
          <div class="delivery-row">
            <div class="delivery-col">
              <p><strong>Receiving Days:</strong> {{deliveryInfo.receivingDays}}</p>
            </div>
            <div class="delivery-col">
              <p><strong>Receiving Hours:</strong> {{deliveryInfo.receivingHours}}</p>
            </div>
          </div>
          <div class="delivery-row">
            <div class="delivery-col">
              <p><strong>Earliest Delivery Date:</strong> {{deliveryInfo.earliestDeliveryDate}}</p>
            </div>
          </div>
          {{#if deliveryInfo.deliveryNotes}}
          <div class="delivery-row">
            <div class="delivery-col">
              <p><strong>Special Notes:</strong> {{deliveryInfo.deliveryNotes}}</p>
            </div>
          </div>
          {{/if}}
        </div>
      </div>
      {{/if}}

      <!-- Order Details -->
      <div class="order-details">
        <h3 class="order-details-title">ORDER DETAILS</h3>
        
        <div class="overflow-x-auto">
          <table class="order-table">
            <thead>
              <tr>
                {{#if (eq orderType 'te')}}
                <!-- TE (Teacher Edition) columns -->
                <th>SKU</th>
                <th>Description</th>
                <th class="center">Sticker</th>
                <th class="center">QTY</th>
                {{else}}
                <!-- PM (Printed Materials) columns -->
                <th>SKU</th>
                <th>Description</th>
                <th class="center">QTY</th>
                {{/if}}
              </tr>
            </thead>
            <tbody>
              {{#each items}}
              <tr class="{{#if @odd}}bg-gray-50{{/if}}">
                {{#if (eq ../orderType 'te')}}
                <!-- TE (Teacher Edition) row -->
                <td>{{sku}}</td>
                <td>{{description}}</td>
                <td class="center">{{#if customProperties.needsSticker}}Yes{{else}}No{{/if}}</td>
                <td class="center qty">{{quantity}}</td>
                {{else}}
                <!-- PM (Printed Materials) row -->
                <td>{{sku}}</td>
                <td>{{description}}</td>
                <td class="center qty">{{quantity}}</td>
                {{/if}}
              </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
        
        <div class="order-summary">
          <p><strong>Total Items:</strong> {{summary.totalItems}}</p>
          <p><strong>Total Quantity:</strong> {{summary.totalQuantity}}</p>
        </div>
      </div>

      <!-- Footer -->
      <div class="footer">
        <div class="footer-content">
          <div class="footer-left">
            <p>Generated on: {{generatedDate}}</p>
            {{#if jobInfo.jobNumber}}
            <p>Job Number: {{jobInfo.jobNumber}}</p>
            {{/if}}
          </div>
          <div class="footer-right">
            <p>Please verify all items before shipping</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</body>
</html>